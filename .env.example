VITE_API_URL=http://localhost:3333
# Site key pública do Google reCAPTCHA v2
VITE_RECAPTCHA_SITE_KEY=
# CNPJ exibido no rodapé dos contratos em PDF
VITE_COMPANY_CNPJ=

# Mapa base (opcional). Sem estas variáveis, os mapas usam o OpenStreetMap com filtro escuro.
# Com uma chave de provedor (ex.: Stadia Maps ou MapTiler), o mapa fica nítido e em alta resolução.
# VITE_MAP_TILES_DARK=https://tiles.stadiamaps.com/tiles/alidade_smooth_dark/{z}/{x}/{y}{r}.png?api_key=SUA_CHAVE
# VITE_MAP_TILES_LIGHT=https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}{r}.png?api_key=SUA_CHAVE
# VITE_MAP_TILES_ATTRIBUTION=

# Login com Google: ID do cliente OAuth (Google Cloud → Credenciais). Sem ele o botão do Google não aparece.
VITE_GOOGLE_CLIENT_ID=
